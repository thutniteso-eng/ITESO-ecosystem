{
  "name": "@iteso/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-generated typed API client from OpenAPI contracts (ADR-008)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
