    "gen": "node scripts/generate.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
