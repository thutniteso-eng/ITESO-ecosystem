# PostgreSQL (Odoo superuser)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=postgres

# PostgreSQL (least-privilege role for API Gateway only)
POSTGRES_GATEWAY_USER=iteso_gateway
POSTGRES_GATEWAY_PASSWORD=change_me_gateway_pg_password

# PostgreSQL (Control Plane role & platform DB)
POSTGRES_CONTROL_PLANE_USER=iteso_control_plane
POSTGRES_CONTROL_PLANE_PASSWORD=change_me_control_plane_pg_password
PLATFORM_DB=platform

# Control Plane Service
CONTROL_PLANE_PORT=3100
# PLATFORM_ENCRYPTION_KEY is generated automatically by ./scripts/generate-keys.sh into infra/secrets/platform_encryption.key
PLATFORM_ENCRYPTION_KEY=
DEMO_ACCOUNTS_PASSWORD=change_me_demo_accounts_password_min10chars
JWT_KEY_ID=iteso-ed25519-key-1

# Odoo 20.0 Community
ODOO_ADMIN_PASSWORD=change_me_odoo_master_password
ODOO_PORT=8069
# Password for admin user in t_demo_fnb (replaces Odoo default admin/admin)
ODOO_DEMO_ADMIN_PASSWORD=change_me_demo_admin_password
# Security & Secrets (TASK-004)
# infra/secrets/platform_encryption.key, ed25519_private.pem, ed25519_public.pem, odoo_credentials.key are generated by scripts/generate-keys.sh
ODOO_MEMBER_KEY_TTL_DAYS=90

# Dev tenant bootstrap
DEMO_TENANT_CODE=demo_fnb
DEMO_TENANT_DB=t_demo_fnb

# Gateway
GATEWAY_PORT=3000

# Admin Web
ADMIN_WEB_PORT=3001
NODE_ENV=development

# Test / QA overrides (leave empty or 900 for normal 15-minute access token TTL)
# ACCESS_TOKEN_TTL_SECONDS=20
ENABLE_API_DOCS=false

