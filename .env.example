# PostgreSQL (Odoo superuser)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=postgres

# PostgreSQL (least-privilege role for API Gateway only)
POSTGRES_GATEWAY_USER=iteso_gateway
POSTGRES_GATEWAY_PASSWORD=change_me_gateway_pg_password

# Odoo 20.0 Community
ODOO_ADMIN_PASSWORD=change_me_odoo_master_password
ODOO_PORT=8069
# Password for admin user in t_demo_fnb (replaces Odoo default admin/admin)
ODOO_DEMO_ADMIN_PASSWORD=change_me_demo_admin_password
# Dev API key seeded into t_demo_fnb admin user for Odoo 20 JSON-2 API (TASK-001 only; replaced by per-user keys in ADR-005)
ODOO_DEV_API_KEY=iteso_dev_api_key_change_me_32chars

# Dev tenant bootstrap (TASK-001)
DEMO_TENANT_CODE=demo_fnb
DEMO_TENANT_DB=t_demo_fnb

# Gateway
GATEWAY_PORT=3000
NODE_ENV=development
